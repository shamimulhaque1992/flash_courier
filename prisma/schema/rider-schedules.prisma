model RiderSchedules {
    id             String              @id @default(uuid())
    startDateTime  DateTime
    endDateTime    DateTime
    totalSlots     Int
    availableSlots Int
    status         RiderScheduleStatus @default(DRAFT)
    isDeleted      Boolean             @default(false)
    deletedAt      DateTime?
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt
    riderId        String
    rider          Riders              @relation(fields: [riderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([riderId, startDateTime, endDateTime], name: "unique_rider_schedule")
    @@map("rider_schedules")
}
