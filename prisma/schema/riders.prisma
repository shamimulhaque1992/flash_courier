model Riders {
    id                        String                  @id @default(uuid())
    name                      String
    email                     String                  @unique
    contactNumber             String                  @unique
    nidNumber                 String                  @unique
    nidDocument               String
    nidDocumentPublicId       String
    additionalDocuments       Json?
    thana                     String
    district                  String
    division                  Division
    address                   String?
    licenseNumber             String?
    vehicleType               String?
    vehicleRegistrationNumber String?
    verificationStatus        RiderVerificationStatus @default(PENDING)
    rejectionReason           String?
    reviewedBy                String?
    reviewedAt                DateTime?
    isDeleted                 Boolean                 @default(false)
    deletedAt                 DateTime?
    createdAt                 DateTime                @default(now())
    updatedAt                 DateTime                @updatedAt

    riderSchedules RiderSchedules[]
    shipments      Shipments[]
    reviews        Reviews[]

    userId String @unique
    user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("riders")
}
