<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Merchant Audit Report</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7fb; padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
            max-width: 560px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
          ">
          <!-- Header -->
          <tr>
            <td style="
                background-color: #2563eb;
                padding: 30px;
                text-align: center;
              ">
              <h1 style="
                  margin: 0;
                  color: #ffffff;
                  font-size: 24px;
                ">
                Audit Report Published
              </h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px;">
              <div style="text-align: center; margin-bottom: 25px;">
                <div style="
                    display: inline-block;
                    width: 64px;
                    height: 64px;
                    line-height: 64px;
                    border-radius: 50%;
                    background-color: #dbeafe;
                    color: #2563eb;
                    font-size: 32px;
                    font-weight: bold;
                  ">
                  📋
                </div>
              </div>

              <p style="
                  margin: 0 0 18px;
                  color: #1f2937;
                  font-size: 16px;
                ">
                Hello <strong><%= name %></strong>,
              </p>

              <p style="
                  margin: 0 0 20px;
                  color: #4b5563;
                  font-size: 15px;
                  line-height: 1.6;
                ">
                An audit report has been generated for your merchant account covering the period below.
                Please find the PDF report attached to this email.
              </p>

              <!-- Audit Period -->
              <div style="
                  background-color: #f8fafc;
                  border-radius: 10px;
                  padding: 20px;
                  margin: 25px 0;
                ">
                <p style="
                    margin: 0 0 12px;
                    color: #64748b;
                    font-size: 12px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                  ">
                  Audit Details
                </p>

                <p style="margin: 0; color: #1f2937; font-size: 15px;">
                  <strong>Merchant:</strong> <%= name %>
                </p>

                <p style="margin: 10px 0 0; color: #1f2937; font-size: 15px;">
                  <strong>Period Start:</strong> <%= startDate %>
                </p>

                <p style="margin: 10px 0 0; color: #1f2937; font-size: 15px;">
                  <strong>Period End:</strong> <%= endDate %>
                </p>
              </div>

              <p style="
                  margin: 25px 0 0;
                  color: #6b7280;
                  font-size: 13px;
                  line-height: 1.6;
                  text-align: center;
                ">
                If you have any questions regarding this report, please contact Flash Courier support.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="
                background-color: #f8fafc;
                padding: 20px 30px;
                text-align: center;
                border-top: 1px solid #e5e7eb;
              ">
              <p style="
                  margin: 0;
                  color: #94a3b8;
                  font-size: 12px;
                ">
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>
