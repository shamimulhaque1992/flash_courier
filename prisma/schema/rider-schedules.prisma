model RiderSchedules {
    id             String              @id @default(uuid())
    dayOfWeek      DayOfWeek
    startTime      String
    endTime        String
    totalSlots     Int
    availableSlots Int
    status         RiderScheduleStatus @default(DRAFT)
    isDeleted      Boolean             @default(false)
    deletedAt      DateTime?
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt
    riderId        String
    rider          Riders              @relation(fields: [riderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    shipments Shipments[]

    @@unique([riderId, dayOfWeek], name: "unique_rider_day_schedule")
    @@map("rider_schedules")
}
