model Shipments {
    id                    String         @id @default(uuid())
    trackingNumber        String         @unique
    otp                   String?         @unique
    receiverName          String
    receiverEmail         String
    receiverContactNumber String
    receiverThana         String
    receiverDistrict      String
    receiverDivision      Division
    receiverAddress       String?
    packageDescription    String?
    packageWeight         Float?
    packageDimensions     String?
    isFragile             Boolean        @default(false)
    deliveryFee           Decimal        @db.Decimal(10, 2)
    paymentStatus         PaymentStatus  @default(PENDING)
    shipmentStatus        ShipmentStatus @default(PENDING_PAYMENT)
    note                  String?
    isDeleted             Boolean        @default(false)
    deletedAt             DateTime?
    createdAt             DateTime       @default(now())
    updatedAt             DateTime       @updatedAt

    pickedUpAt           DateTime?
    probableDeliveryTime DateTime?
    actualDeliveryTime   DateTime?

    merchantId String
    merchant   Merchants  @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    customerId String?
    customer   Customers? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    riderId    String?
    rider      Riders?    @relation(fields: [riderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    scheduleId String?
    schedule   RiderSchedules? @relation(fields: [scheduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    payment         Payments?
    shipmentHistory ShipmentHistories[]
    reviews         Reviews?

    @@map("shipments")
}
