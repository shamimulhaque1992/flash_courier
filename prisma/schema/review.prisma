model Reviews {
    id          String   @id @default(uuid())
    merchantRating      Int
    riderRating      Int
    comment     String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    customerId  String
    merchantId  String
    riderId    String
    customer    Customers @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    merchant    Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    rider       Riders    @relation(fields: [riderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("reviews")
}