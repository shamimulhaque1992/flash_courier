<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Shipment Is On Its Way</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f4f7fb;font-family:Arial,Helvetica,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f7fb;padding:40px 20px;">
      <tr>
        <td align="center">
          <table width="100%" cellpadding="0" cellspacing="0" border="0"
            style="max-width:560px;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.08);">

            <!-- Header -->
            <tr>
              <td style="background-color:#f97316;padding:30px;text-align:center;">
                <h1 style="margin:0;color:#ffffff;font-size:24px;">Shipment On Its Way!</h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding:40px 35px;">
                <p style="margin:0 0 18px;color:#1f2937;font-size:16px;">
                  Hello <strong><%= receiverName %></strong>,
                </p>
                <p style="margin:0 0 25px;color:#4b5563;font-size:15px;line-height:1.6;">
                  Great news! Your shipment has been assigned to a rider and is on its way to you.
                  Please find the details below.
                </p>

                <!-- Shipment Details -->
                <div style="background-color:#f8fafc;border-radius:10px;padding:20px;margin:25px 0;">
                  <p style="margin:0 0 15px;color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:0.5px;">Shipment Details</p>
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td style="padding:8px 0;color:#64748b;font-size:14px;">Tracking Number</td>
                      <td align="right" style="padding:8px 0;color:#f97316;font-size:14px;font-weight:bold;"><%= trackingNumber %></td>
                    </tr>
                    <tr>
                      <td style="padding:8px 0;color:#64748b;font-size:14px;">Rider Name</td>
                      <td align="right" style="padding:8px 0;color:#1f2937;font-size:14px;font-weight:bold;"><%= riderName %></td>
                    </tr>
                    <tr>
                      <td style="padding:8px 0;color:#64748b;font-size:14px;">Probable Delivery</td>
                      <td align="right" style="padding:8px 0;color:#1f2937;font-size:14px;font-weight:bold;"><%= probableDeliveryTime %></td>
                    </tr>
                  </table>
                </div>

                <!-- OTP Box -->
                <div style="background-color:#fff7ed;border:2px dashed #f97316;border-radius:10px;padding:25px;margin:25px 0;text-align:center;">
                  <p style="margin:0 0 8px;color:#64748b;font-size:13px;text-transform:uppercase;letter-spacing:0.5px;">Delivery Verification OTP</p>
                  <p style="margin:0;color:#f97316;font-size:40px;font-weight:bold;letter-spacing:8px;"><%= otp %></p>
                  <p style="margin:10px 0 0;color:#6b7280;font-size:13px;line-height:1.6;">
                    Share this OTP <strong>only</strong> with the rider when they arrive to deliver your package.
                    Do not share it with anyone else.
                  </p>
                </div>

                <div style="background-color:#fefce8;border-left:4px solid #eab308;padding:15px 18px;margin:25px 0;">
                  <p style="margin:0;color:#475569;font-size:13px;line-height:1.6;">
                    <strong>Note:</strong> Your delivery invoice is attached to this email. The OTP is required to confirm delivery.
                  </p>
                </div>

                <p style="margin:25px 0 0;color:#6b7280;font-size:13px;line-height:1.6;text-align:center;">
                  Thank you for choosing Flash Courier.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background-color:#f8fafc;padding:20px 30px;text-align:center;border-top:1px solid #e5e7eb;">
                <p style="margin:0;color:#94a3b8;font-size:12px;">This is an automated email. Please do not reply.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
