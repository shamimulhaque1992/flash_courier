model Shipments {
    id                    String         @id @default(uuid())
    trackingNumber        String         @unique
    merchantName          String
    merchantEmail         String
    merchantContactNumber String
    merchantThana         String
    merchantDistrict      String
    merchantDivision      String
    merchantAddress       String
    receiverName          String
    receiverEmail         String
    receiverContactNumber String
    receiverThana         String
    receiverDistrict      String
    receiverDivision      String
    receiverAddress       String?
    packageDescription    String?
    packageWeight         Float?
    packageDimensions     String?
    deliveryFee           Decimal        @db.Decimal(10, 2)
    paymentStatus         PaymentStatus  @default(PENDING)
    shipmentStatus        ShipmentStatus @default(PENDING)
    note                  String?
    isDeleted             Boolean        @default(false)
    deletedAt             DateTime?
    createdAt             DateTime       @default(now())
    updatedAt             DateTime       @updatedAt

    payment         Payments?
    shipmentHistory ShipmentHistories?

    @@map("shipments")
}
